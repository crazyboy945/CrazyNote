#!/bin/bash
# crazynote 生命周期脚本
# 环境变量由 fnOS 注入：TRIM_APPDEST / TRIM_PKGETC / TRIM_PKGVAR 等

set -u

APP_NAME="crazynote"
BIN_NAME="crazynote"

# 应用安装目录（只读，随版本升级刷新）
APPDEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
# 应用私有配置目录（升级保留）
PKGETC="${TRIM_PKGETC:-/var/apps/${APP_NAME}/etc}"
# 应用持久数据目录（升级保留）
PKGVAR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"

PID_FILE="${PKGVAR}/crazynote.pid"
LOG_FILE="${PKGVAR}/crazynote.log"

# 笔记根目录：向导可指定，否则用应用数据目录下的 notes
NOTES_DIR="$(cat "${PKGETC}/data-dir" 2>/dev/null || true)"
if [ -z "${NOTES_DIR}" ]; then
  NOTES_DIR="${PKGVAR}/notes"
fi

# 局域网监听端口
PORT="$(cat "${PKGETC}/port" 2>/dev/null || true)"
if [ -z "${PORT}" ]; then
  PORT="8899"
fi

# 网关 Unix Socket
SOCKET_PATH="${APPDEST}/crazynote.sock"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [$1] $2" >> "${LOG_FILE}" 2>/dev/null || true
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$2" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
  fi
}

find_binary() {
  for arch in x86_64 aarch64 armv7l; do
    local p="${APPDEST}/bin/crazynote-linux-${arch}"
    if [ -x "${p}" ]; then
      echo "${p}"
      return 0
    fi
  done
  if [ -x "${APPDEST}/bin/crazynote" ]; then
    echo "${APPDEST}/bin/crazynote"
    return 0
  fi
  return 1
}

is_running() {
  [ -f "${PID_FILE}" ] || return 1
  local pid
  pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
  [ -n "${pid}" ] || return 1
  # 校验进程确实存在，避免 PID 复用误判
  if [ -d "/proc/${pid}" ]; then
    return 0
  fi
  return 1
}

cmd_install() {
  mkdir -p "${PKGETC}" "${PKGVAR}" "${APPDEST}/bin" 2>/dev/null || true
  if [ ! -x "${APPDEST}/bin/crazynote-linux-x86_64" ] && ! find_binary >/dev/null; then
    log error "未找到可执行文件，安装包可能损坏"
    return 1
  fi
  log info "安装完成，笔记目录: ${NOTES_DIR}"
  return 0
}

cmd_uninstall() {
  cmd_stop || true
  log info "卸载完成（数据保留在 ${PKGVAR}）"
  return 0
}

cmd_start() {
  if is_running; then
    log info "服务已在运行"
    return 0
  fi
  local bin
  if ! bin="$(find_binary)"; then
    log error "找不到可执行文件"
    return 1
  fi
  mkdir -p "${PKGVAR}" "${NOTES_DIR}" 2>/dev/null || true

  nohup "${bin}" \
    -data "${NOTES_DIR}" \
    -appdata "${PKGETC}" \
    -addr "0.0.0.0:${PORT}" \
    -socket "${SOCKET_PATH}" \
    -prefix "/app/${APP_NAME}" \
    >> "${LOG_FILE}" 2>&1 &

  echo $! > "${PID_FILE}"
  sleep 2
  if is_running; then
    log info "启动成功，PID=$(cat "${PID_FILE}")，端口 ${PORT}"
    return 0
  fi
  log error "启动失败，请查看 ${LOG_FILE}"
  return 1
}

cmd_stop() {
  if ! is_running; then
    rm -f "${PID_FILE}"
    return 0
  fi
  local pid
  pid="$(cat "${PID_FILE}")"
  kill "${pid}" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! is_running; then
      rm -f "${PID_FILE}"
      log info "已停止"
      return 0
    fi
    sleep 0.5
  done
  kill -9 "${pid}" 2>/dev/null || true
  rm -f "${PID_FILE}"
  log info "已强制停止"
  return 0
}

cmd_status() {
  if is_running; then
    return 0
  fi
  return 3
}

case "${1:-}" in
  install)     cmd_install ;;
  uninstall)   cmd_uninstall ;;
  start)       cmd_start ;;
  stop)        cmd_stop ;;
  status)      cmd_status ;;
  *)
    echo "用法: $0 {install|uninstall|start|stop|status}" >&2
    exit 1
    ;;
esac
